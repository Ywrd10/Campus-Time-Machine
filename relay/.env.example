# Copy to relay/.env.local (gitignored). These are secrets: never commit them or prefix them with VITE_.
#
# Recommended: the Radeon dashboard session. The relay follows "Open notebook" (/api/notebook/open) itself
# whenever the Jupyter gateway turns it away, and learns the instance URL from that redirect.
# Value of the __Host-oneclick-manager cookie on radeon-global.anruicloud.com (DevTools → Application →
# Cookies), valid ~2 weeks. Quote it.
RADEON_SESSION="..."
#
# Alternative (no auto-refresh): the instance URL (JupyterLab URL without /lab) plus the full Cookie request
# header from a JupyterLab request in DevTools → Network. Also usable alongside RADEON_SESSION as a head start.
# JUPYTER_URL=https://jupyter.anruicloud.com/instances/<instance-id>
# JUPYTER_COOKIE="name1=value1; name2=value2"
PORT=8000
#
# Optional: remote storage for journeys and the Wall in a *public* Hugging Face Storage Bucket
# (huggingface.co/new-bucket). Make a fine-grained write token scoped to the bucket, then use its menu's
# "Generate S3 credentials". Without these, journeys stay in relay/wall.json and relay/cache/ only.
# HF_BUCKET=<namespace>/<bucket>
# HF_S3_KEY_ID=HFAK...
# HF_S3_SECRET="..."
# Optional: RELAY_DEBUG=1 logs each login step (cookie names only, never values).
