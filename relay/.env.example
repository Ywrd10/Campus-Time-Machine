# Copy to relay/.env.local (gitignored). These are secrets: never commit them or prefix them with VITE_.
# Instance base URL, i.e. the JupyterLab URL without the trailing /lab.
JUPYTER_URL=https://jupyter.anruicloud.com/instances/<instance-id>
# Full Cookie request header from any JupyterLab request in Chrome DevTools → Network
# (open the notebook from the Radeon dashboard first). Quote it.
JUPYTER_COOKIE="name1=value1; name2=value2"
# Optional: only needed if Jupyter starts enforcing XSRF (value of the _xsrf cookie).
JUPYTER_XSRF=
PORT=8000
